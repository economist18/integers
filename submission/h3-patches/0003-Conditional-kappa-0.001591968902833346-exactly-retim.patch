+if not __debug__: raise SystemExit('assertions must stay enabled')
+ROOT = Path(__file__).resolve().parent; RES = ROOT.parent
+S44 = RES / 'static44-selective'; R420 = RES / 'e8-bit-r420'; P531 = S44 / 'vendor/pr531'
+A9 = R420 / 'vendor/pr510/e8-r480-nine-stage/code/assemble9.py'
