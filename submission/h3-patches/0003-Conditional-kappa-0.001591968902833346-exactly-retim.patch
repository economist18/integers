+"""Exact complex endpoint from the fresh owner audit: two independent rational moment engines.
+
+Usage: price_complex.py BASE_DIR AUDIT_DIR OUT.json
+Uses the pinned engines bound into BASE_DIR/work/pr361 by prepare_supplier_base.py. Accepts b and
+rejects b + 10^-24 in both engines, with the inherited bad-cover fallback, exactly as PR531/535's
+assemblers do. Also checks every strict finite invoice inequality. Apache-2.0; Claude Code assistance.
+"""
+import importlib.util, json, sys, hashlib
+from fractions import Fraction as Q
+from pathlib import Path
+
+V, A, OUT = map(Path, sys.argv[1:4])
+def load(n):
+    s = importlib.util.spec_from_file_location('e_' + n, V / 'work/pr361/code/engines' / (n + '.py'))
+    m = importlib.util.module_from_spec(s); s.loader.exec_module(m); return m
+M, Other = load('moment'), load('base_two_moment')
+owner = json.loads((A / 'OWNERS-AND-PROFILE.json').read_text()); inv = json.loads((A / 'PREFIX-AND-INVOICE.json').read_text())
+assert owner['template_sha256'] == inv['template_sha256'] and all(inv['strict_checks'].values())
+P = {int(r): n for r, n in owner['paid_profile'].items()}; m, W = 73, owner['live']
+assert m * W - sum(r * n for r, n in P.items()) == 2560 and m * m > 2 * max(P) ** 2
+rc = M.certify(P, m, W, True); b = Q(rc['lower']); bp = Q(rc['upper']); assert bp - b == Q(1, 10 ** 24)
+fallback = 32 * m * m * sum(P.values()); receipts = []
+for z, accept in [(b, True), (bp, False)]:
+    lo, hi = M.moment(P, m, W, z, True); a, c = Other.moment(m, W, list(P.items()), z); d, e = Other.moment(m, W, [(1, fallback)], z)
+    a += d / 10 ** 16; c += e / 10 ** 16
+    assert (hi < 1 and c < 1) if accept else (lo > 1 and a > 1)
+    receipts.append(dict(endpoint=str(z), accept=accept, mercator=[str(lo - 1), str(hi - 1)], base_two=[str(a - 1), str(c - 1)]))
+res = dict(status='PASS_TWO_ENGINE_COMPLEX_ENDPOINT', complex_lower=str(b), complex_decimal=rc['lower'], next_b_rejected=str(bp),
+           receipts=receipts, paid_profile=owner['paid_profile'], live=W, template_sha256=owner['template_sha256'],
+           physical_row_coefficient=inv['finite']['physical_row_coefficient'], global_prefix_bits=inv['global_prefix_bits'],
+           owner_audit_sha256=hashlib.sha256((A / 'OWNERS-AND-PROFILE.json').read_bytes()).hexdigest())
+OUT.write_text(json.dumps(res, indent=2) + '\n'); print(res['status'], res['complex_decimal'])
