+"""Fresh offline verification: exact-retimed static44 complex supplier with the R420 bit supplier.
+
+Usage: python3 -B verify.py --work /absolute/new/dir --boost-include /usr/include [--cxx c++]
+Requires Python 3.12+ with NumPy and SymPy, bash, a C++17 compiler and Boost headers.
+Runs, unmodified, PR544's verifier (static44, both its suppliers) and PR543's verifier (R420 bit);
+applies the frozen exact lifts; re-runs PR531's local/global complex pipeline and PR544's full phase
+lowering on the changed word; prices it with two exact engines; and composes it with the fresh R420
+bit result through PR543/PR510's own assemble9.py. No solver or network. Apache-2.0; prepared with
+Anthropic Claude (Claude Code) assistance.
+"""
+import argparse, copy, gzip, hashlib, json, os, shutil, subprocess, sys, time
+from fractions import Fraction as Q
+from pathlib import Path
