+"""Apply the frozen exact lifts-only frame map to PR544's static44 complex word.
+
+Usage: apply_lifts.py STATIC44_FULL-WORD.json.gz LIFT-MAP.json OUT_FULL-WORD.json.gz
+
+Checks: the source equals the pinned word (every field, except PR535's two documented floating
+entropy displays); every map entry names the gate's current frame; every new frame contains it
+(a lift, the interface of PR534/PR531's coalescing); no index repeats; scalar payloads, order and
+all non-frame fields are unchanged; every register chain stays nested through start, cut, centre,
+target-level and final frames; the recomputed local profile equals the expected one.
+Prepared with Anthropic Claude (Claude Code) assistance; Apache-2.0.
+"""
+import copy, gzip, hashlib, json, sys
+from collections import Counter
+from pathlib import Path
+
+if not __debug__: raise SystemExit('assertions must stay enabled')
+
+
+def basis(vs):
+    b = {}
+    for x in vs:
+        for p in sorted(b, reverse=True):
+            if x >> p & 1: x ^= b[p]
+        if x:
+            p = x.bit_length() - 1
+            for q in b:
+                if b[q] >> p & 1: b[q] ^= x
+            b[p] = x
+    return tuple(b[p] for p in sorted(b, reverse=True))
+
+
+def inside(a, b): return basis(list(a) + list(b)) == basis(b)
+def canon(x): return json.dumps(x, sort_keys=True, separators=(',', ':')).encode()
+
+
+def portable(w):
+    z = copy.deepcopy(w); fc = z['report'].get('frame_coalescing')
+    if fc:
+        for k in ('local_entropy_before', 'local_entropy_after'): fc.pop(k, None)
+    return hashlib.sha256(canon(z)).hexdigest()
+
+
+def profile(w):
+    """Native climb rule of PR484 audit_gk / PR531 audit_and_transport (nested frames)."""
+    v = len(w['ports']); n = 2 * v + w['report']['R']; full = basis([1 << i for i in range(9)])
+    cur = [basis([p]) for p in w['ports']] + [()] * v + [basis(w['start_extra'].get(str(r), [])) for r in range(2 * v, n)]
+    paid = Counter(); lev = {int(t): basis(E) for t, E in w.get('target_levels', {}).items()}
+    def climb(r, F):
+        F = basis(F); assert inside(cur[r], F), ('non-nested frame', r)
+        if cur[r] != F: paid[len(F) - len(cur[r])] += 1; cur[r] = F
+    for part in ('A', 'B'):
+        if part == 'B':
+            assert all(cur[v + t] == lev.get(t, ()) for t in range(v)), 'target level at cut'
+            for r, F in zip(w['centers'], w['center_frames']):
+                old = basis(F); assert cur[r] == old, 'centre frame at cut'
+                for E in sorted({lev.get(e[1] - v, ()) for e in w['cut'] if e[2] == r}, key=lambda E: -len(E)):
+                    assert inside(E, old)
+                    if old != E: paid[len(old) - len(E)] += 1; old = E
+        for e in w[part]:
+            for r in ([e[1], e[2]] if e[0] == 'add' else [e[1]]): climb(r, e[-1])
+    for r in range(n):
+        climb(r, basis([x for x in range(1, 512) if not (x & w['ports'][r - v]).bit_count() % 2]) if v <= r < 2 * v else full)
+    return dict(sorted(paid.items()))
+
+
+def main(src, mapfile, out):
+    assert not out.exists()
+    w = json.loads(gzip.decompress(src.read_bytes())); m = json.loads(mapfile.read_text())
+    assert portable(w) == m['source_portable_sha256'], 'source word differs from pinned PR544 static44 word'
+    assert profile(w) == {int(k): x for k, x in m['given_local_profile'].items()}
+    z = copy.deepcopy(w); seen = set()
+    for part, i, old, new in m['lifts']:
+        assert (part, i) not in seen and part in ('A', 'B'); seen.add((part, i))
+        assert z[part][i][-1] == old, ('stale map entry', part, i)
+        assert inside(basis(old), basis(new)) and basis(old) != basis(new), ('not a strict lift', part, i)
+        z[part][i][-1] = new
+    for part in ('A', 'B'): assert [e[:-1] for e in z[part]] == [e[:-1] for e in w[part]]
+    for k in w:
+        if k not in ('A', 'B', 'report'): assert z[k] == w[k], k
+    p = profile(z); assert p == {int(k): x for k, x in m['expected_local_profile'].items()}, p
+    assert sum(r * x for r, x in p.items()) == sum(r * x for r, x in profile(w).items()), 'rank mass changed'
+    z['report']['local_profile'] = {str(k): x for k, x in p.items()}
+    assert portable(z) == m['candidate_portable_sha256']
+    out.parent.mkdir(parents=True, exist_ok=True); out.write_bytes(gzip.compress(canon(z), mtime=0))
+    print(json.dumps(dict(status='PASS_FROZEN_EXACT_LIFTS_APPLIED', lifted_gate_frames=len(m['lifts']),
+                          local_profile=p, rank_mass=sum(r * x for r, x in p.items()))))
+
+
+if __name__ == '__main__': main(*map(Path, sys.argv[1:4]))
