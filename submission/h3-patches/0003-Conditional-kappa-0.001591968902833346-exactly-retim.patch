+assert inv() == read(ROOT / 'MANIFEST.json'), 'package manifest'
+O.mkdir(parents=True); steps = []; t0 = time.monotonic()
+env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', PYTHONINTMAXSTRDIGITS='0', PATH=str(Path(sys.executable).parent) + os.pathsep + os.environ['PATH'])
