+"""Check that the published frame-only retimings of three frontier complex words are optimal.
+
+For each word the exact ILP (code/retime_ilp.py, HiGHS via SciPy) minimises the moment LHS weight
+sum d*(73/d)**b0 over every feasible frame assignment of the free gates, with b0 the word's own moment
+root, the scalar payloads, entrances, target levels, centre frames and the fixed prelude kept. The
+optimum must equal the published retimed profile. Usage: python3 -B check.py OUTDIR
+Requires numpy and scipy. Floating MILP (gap 0), not an exact rational certificate.
+"""
+import json, gzip, os, subprocess, sys, hashlib, copy
+from pathlib import Path
+HERE = Path(__file__).resolve().parent; sys.path.insert(0, str(HERE / 'code'))
+import retime_model as R
+OUT = Path(sys.argv[1]).resolve(); assert not OUT.exists(); OUT.mkdir(parents=True)
+cases = json.loads((HERE / 'CASES.json').read_text())
+read = lambda p: json.loads(gzip.decompress(p.read_bytes()))
+results = {}
+for c in cases:
+    p = HERE / 'words' / c['word']; assert hashlib.sha256(p.read_bytes()).hexdigest() == c['sha256_gzip'], c['word']
+    os.environ['FIXED_A'] = str(c['fixed_prelude'])
+    import importlib; importlib.reload(R)
+    w = read(p); W = R.Word(w)
+    assert W.profile() == {int(k): v for k, v in c['published_local_profile'].items()}, ('model profile', c['name'])
+    out = OUT / (c['name'] + '.json')
+    r = subprocess.run([sys.executable, '-B', str(HERE / 'code/retime_ilp.py'), str(p), '-', c['b0'], str(out), '900'], env=dict(os.environ), capture_output=True, text=True)
+    (OUT / (c['name'] + '.log')).write_text(r.stdout + r.stderr); assert r.returncode == 0, r.stderr[-2000:]
+    res = json.loads(out.read_text())
+    assert {int(k): v for k, v in res['profile'].items()} == W.profile(), ('ILP optimum differs from published', c['name'], res['profile'])
+    results[c['name']] = dict(optimum_profile=res['profile'], objective=res['objective'], equals_published=True)
+    print('PASS', c['name'], res['profile'], flush=True)
+# start independence: ILP from the unretimed PR484 word reaches the PR501 optimum
+os.environ['FIXED_A'] = '531'
+w0 = HERE / 'words/pr484-unretimed.json.gz'
+importlib.reload(R); W0 = R.Word(read(w0))
+assert W0.profile() == {int(k): v for k, v in read(w0)['report']['local_profile'].items()}, 'model != repository climb rule on the unretimed word'
+r = subprocess.run([sys.executable, '-B', str(HERE / 'code/retime_ilp.py'), str(w0), '-', cases[0]['b0'], str(OUT / 'from-unretimed.json'), '900'], env=dict(os.environ), capture_output=True, text=True)
+assert r.returncode == 0 and json.loads((OUT / 'from-unretimed.json').read_text())['profile'] == results[cases[0]['name']]['optimum_profile']
+print('PASS start-independence: unretimed PR484 word -> PR501 optimum', flush=True)
+# control: a frame outside the nesting chain must be rejected by the model
+W1 = R.Word(read(HERE / 'words' / cases[0]['word'])); g = next(g for g in range(len(W1.events)) if g not in W1.fixed and g not in W1.forced and len(W1.F[g]) > 1)
+W1.F[g] = R.basis([W1.F[g][0]])
+try: W1.profile(); raise SystemExit('control accepted')
+except AssertionError: print('PASS control: non-nested frame rejected', flush=True)
+(OUT / 'RESULT.json').write_text(json.dumps(dict(status='PASS_PUBLISHED_RETIMINGS_ARE_ILP_OPTIMAL', results=results), indent=2) + '\n')
diff --git a/research/exact-retiming-optimality/code/retime_ilp.py b/research/exact-retiming-optimality/code/retime_ilp.py
